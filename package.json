    "opencc-js": "^1.4.2",
    "pinyin-pro": "^3.29.3",
    "polygon-clipping": "^0.15.7",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.33.5",
