    "@tiptap/starter-kit": "^2.6.6",
    "@types/diff": "^7.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3": "^11.3.0",
    "clsx": "^2.1.1",
    "colord": "^2.10.0",
    "cors": "^2.8.5",
    "diff": "^9.0.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "gif-encoder-2": "^1.0.5",
